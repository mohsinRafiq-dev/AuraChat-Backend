NODE_ENV=development
PORT=4000
# In development, if unset, defaults to mongodb://127.0.0.1:27017/chat-app (see src/config/env.js).
MONGODB_URI=mongodb://127.0.0.1:27017/chat-app
# In development, if unset, a dev-only default is used (never rely on this in production).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Skip JWT (dev user). In NODE_ENV=development this defaults to ON unless SKIP_AUTH=false.
# SKIP_AUTH=true

# Google Sign-In (Web) — OAuth 2.0 Client ID from Google Cloud Console → Web application
# Authorized JavaScript origins: http://localhost:5173 (and your production URL)
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# Optional — only for server redirect / refresh-token flows, not for GIS ID token verification:
# GOOGLE_CLIENT_SECRET=

# Optional — Redis for Socket.IO multi-node (`@socket.io/redis-adapter`)
# REDIS_URL=redis://127.0.0.1:6379

# Aura — in-app assistant (Google Gemini)
# Get a key at https://aistudio.google.com/apikey
# When unset, Aura is simply unavailable; the rest of the app is unaffected.
# GEMINI_API_KEY=
# Optional: pin a specific model instead of the latest flash alias.
# GEMINI_MODEL=gemini-flash-latest
