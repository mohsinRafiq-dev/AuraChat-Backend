# AuraChat backend — production environment (EC2)
#
# Copy to /srv/aurachat/backend/.env and lock it down:
#   sudo install -o root -g ubuntu -m 640 .env.production.example /srv/aurachat/backend/.env
#
# NODE_ENV=production changes real behaviour, not just logging:
#   - env.js throws on startup if MONGODB_URI or JWT_SECRET are missing
#   - error responses stop leaking internal messages to clients
#   - Mongoose autoIndex is off (run `node scripts/sync-indexes.js` once)

NODE_ENV=production
PORT=4000

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Atlas → Database → Connect → Drivers. Append the database name before the "?".
# URL-encode the password if it contains @ : / ? # [ ] or %
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/chat-app?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a real one — do NOT reuse the dev default:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Must be false in production. `true` disables JWT auth entirely.
SKIP_AUTH=false

# ── Network ──────────────────────────────────────────────────────────────────
# Exact origin of the deployed frontend — scheme + host, no trailing slash.
# Comma-separate to also allow Vercel preview deployments.
CORS_ORIGIN=https://your-app.vercel.app

# Number of reverse proxies in front of the app. 1 for a single Nginx.
# Leave unset (0) only when Node is exposed directly, which it should not be.
TRUST_PROXY=1

# ── Google Sign-In ───────────────────────────────────────────────────────────
# Same Web client ID the frontend uses. Add the Vercel origin to the client's
# "Authorized JavaScript origins" in Google Cloud Console, or sign-in 400s.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Aura assistant (optional) ────────────────────────────────────────────────
# Unset = Aura is unavailable; nothing else is affected.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Redis (optional) ─────────────────────────────────────────────────────────
# Only needed to run more than one Node process/instance. A single EC2 box
# running one process does not need this.
# REDIS_URL=redis://127.0.0.1:6379
